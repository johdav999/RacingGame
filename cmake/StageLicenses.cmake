file(MAKE_DIRECTORY "${SITE_DIR}/licenses")
foreach(dep cgltf ufbx stb meshoptimizer)
  if(EXISTS "${ENGINE_DIR}/third_party/${dep}/LICENSE")
    file(COPY_FILE "${ENGINE_DIR}/third_party/${dep}/LICENSE" "${SITE_DIR}/licenses/${dep}.txt")
  elseif(EXISTS "${ENGINE_DIR}/third_party/${dep}/LICENSE.md")
    file(COPY_FILE "${ENGINE_DIR}/third_party/${dep}/LICENSE.md" "${SITE_DIR}/licenses/${dep}.txt")
  endif()
endforeach()
file(COPY_FILE "${JOLT_DIR}/LICENSE" "${SITE_DIR}/licenses/Jolt.txt")
file(COPY_FILE "${ENGINE_DIR}/third_party/recastnavigation/License.txt" "${SITE_DIR}/licenses/RecastNavigation.txt")
if(EXISTS "${ENGINE_DIR}/LICENSE")
  file(COPY_FILE "${ENGINE_DIR}/LICENSE" "${SITE_DIR}/licenses/WebEngine.txt")
endif()
